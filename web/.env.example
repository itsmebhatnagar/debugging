# ==============================================================================
# JUDGE0 HOSTED COMPILER CONFIGURATION (Backend Only)
# ==============================================================================
# Required: Hosted Judge0-compatible execution API endpoint.
# Must use HTTPS, no trailing query parameters, credentials, or fragments.
# Example self-hosted: https://judge0.yourdomain.com
# Example RapidAPI:    https://judge0-ce.p.rapidapi.com
JUDGE0_API_URL="https://judge0-ce.p.rapidapi.com"

# Optional: Authentication for Self-Hosted Judge0 (sent via X-Auth-Token / X-Auth-User)
JUDGE0_AUTHN_TOKEN=""
JUDGE0_AUTHZ_TOKEN=""

# Optional: Authentication for RapidAPI Judge0 (sent via X-RapidAPI-Key & X-RapidAPI-Host)
JUDGE0_RAPIDAPI_KEY=""

# SECURITY WARNING: Never prefix any compiler or database variables with NEXT_PUBLIC_.

